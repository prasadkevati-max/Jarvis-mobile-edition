<button id="send">SEND</button>
<button id="mic-btn"></button>
<button id="clear-btn"></button>
<button id="cam-btn"></button>
<input type="file" id="img-input" accept="image/*" capture="environment" style="display:none">

<script>
(function () {
  const btns = [...document.querySelectorAll("button")];
  const find = t => btns.find(b => b.textContent.toUpperCase().includes(t));
  const execBtn = find("EXECUTE"), micBtn = find("🎤"),
        camBtn = find("📷"), clearBtn = find("CLEAR");
  const input = document.querySelector("input[type=text], input:not([type])");

  // Chat output box (auto-created below buttons)
  const out = document.createElement("div");
  out.style.cssText = "color:#0f0;padding:10px;max-height:200px;overflow-y:auto;text-align:left";
  (clearBtn.parentElement.parentElement || document.body).appendChild(out);

  const video = document.createElement("video");
  video.autoplay = true; video.playsInline = true; video.muted = true;
  video.style.cssText = "display:none;width:100%;max-height:240px";
  const canvas = document.createElement("canvas");
  canvas.style.cssText = "display:none;width:100%";
  out.after(video, canvas);

  const KEY = "jarvis_history";
  let hist = [];
  try { hist = JSON.parse(localStorage.getItem(KEY)) || []; } catch (e) {}

  function add(who, text) {
    const d = document.createElement("div");
    d.textContent = who + ": " + text;
    out.appendChild(d);
    out.scrollTop = out.scrollHeight;
  }
  function remember(who, text) {
    hist.push([who, text]);
    try { localStorage.setItem(KEY, JSON.stringify(hist.slice(-50))); } catch (e) {}
  }
  function reply(text) {
    add("Jarvis", text); remember("Jarvis", text);
    if ("speechSynthesis" in window) {
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(text);
      u.lang = /[\u0C00-\u0C7F]/.test(text) ? "te-IN" : "en-IN";
      speechSynthesis.speak(u);
    }
  }

  // EXECUTE
  function run(text) {
    text = (text || "").trim();
    if (!text) return;
    add("You", text); remember("You", text);
    if (input) input.value = "";
    const t = text.toLowerCase();
    if (t.includes("time")) reply("Ippudu " + new Date().toLocaleTimeString());
    else if (t.includes("date")) reply("Ee roju " + new Date().toLocaleDateString());
    else if (t.includes("open youtube")) { reply("YouTube open chestunnanu"); window.open("https://youtube.com", "_blank"); }
    else reply("Ee command naaku teliyadu. Try: time, date, open youtube");
  }
  execBtn.onclick = () => run(input && input.value);
  if (input) input.addEventListener("keydown", e => { if (e.key === "Enter") run(input.value); });

  // MIC
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  micBtn.onclick = () => {
    if (!SR) return reply("Ee browser lo mic support ledu. Chrome vaadandi.");
    const rec = new SR();
    rec.lang = "te-IN"; // English kosam "en-IN"
    rec.onresult = e => run(e.results[0][0].transcript);
    rec.onerror = e => reply("Mic error: " + e.error);
    rec.start();
  };

  // CAMERA: 1st tap = on, 2nd tap = photo
  let stream = null;
  camBtn.onclick = async () => {
    if (!stream) {
      try {
        stream = await navigator.mediaDevices.getUserMedia({ video: true });
        video.srcObject = stream;
        video.style.display = "block"; canvas.style.display = "none";
      } catch (e) { reply("Camera permission ivvandi."); }
    } else {
      canvas.width = video.videoWidth; canvas.height = video.videoHeight;
      canvas.getContext("2d").drawImage(video, 0, 0);
      canvas.style.display = "block";
      stream.getTracks().forEach(t => t.stop());
      stream = null; video.style.display = "none";
      reply("Photo teesanu.");
    }
  };

  // CLEAR MEMORY
  clearBtn.onclick = () => {
    hist = [];
    localStorage.removeItem(KEY);
    out.innerHTML = "";
    canvas.style.display = "none";
    reply("History clear ayyindi.");
  };

  hist.forEach(h => add(h[0], h[1]));
})();
</script>
